    "CFBundleDisplayName": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set Counter"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세트 카운터"
          }
        }
      }
    },
    "NSHealthShareUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needed to measure your heart rate during workouts and send it to Set Counter on your iPhone."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "운동 중 심박수를 재서 iPhone의 세트 카운터로 보내기 위해 필요해요."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needed to save strength workouts and calories measured on your Watch to the Health app."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "워치에서 잰 근력 운동과 소모 칼로리를 건강 앱에 저장하기 위해 필요해요."
          }
        }
      }
    }
  },
  "version": "1.0"
}