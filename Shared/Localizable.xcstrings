            "value": "Add Record"
          }
        }
      }
    },
    "기록, 세트별 무게·횟수, 운동 부위, 앱 설정이 파일 하나에 담겨요. 파일 앱이나 iCloud Drive에 저장해두면 새 iPhone이나 재설치 후에 복원할 수 있어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One file holds your records, every set's weight and reps, body parts, and settings. Save it to Files or iCloud Drive to restore on a new iPhone or after reinstalling."
          }
        }
      }
    },
    "기록이 모두 고른 운동 이름으로 옮겨져요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
