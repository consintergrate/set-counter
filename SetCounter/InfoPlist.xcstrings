{
  "sourceLanguage": "ko",
  "strings": {
    "CFBundleDisplayName": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세트 카운터"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set Counter"
          }
        }
      }
    },
    "NSAlarmKitUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면이 잠겨 있을 때도 쉬는 시간이 끝나면 알람을 울리기 위해 필요해요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needed to ring an alarm when your rest ends, even with the screen locked."
          }
        }
      }
    },
    "NSBluetoothAlwaysUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "블루투스 심박 센서에서 운동 중 심박수를 받기 위해 필요해요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needed to read your heart rate from a Bluetooth heart rate sensor during workouts."
          }
        }
      }
    },
    "NSHealthShareUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "걸음 수, 활동 칼로리, 체중, 먹은 칼로리, 심박수와 나이키 런 클럽 같은 다른 앱의 운동 기록을 읽어 하루 칼로리, 활동 목표, 유산소 기록을 보여주기 위해 필요해요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needed to read steps, active energy, body weight, dietary energy, heart rate, and workouts from other apps such as Nike Run Club to show your daily calories, activity goals, and cardio."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마친 근력 운동과 소모 칼로리, 직접 기록한 체중과 식사(음식 이름·칼로리·메모)를 건강 앱에 저장하기 위해 필요해요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needed to save finished strength workouts and calories, and the body weight and meals (food names, calories, memo) you log, to the Health app."
          }
        }
      }
    }
  },
  "version": "1.0"
}
